<% content_for :title, t(".title") %>

<div class="w-full max-w-lg">
  <h1 class="text-2xl font-bold mb-6"><%= t(".title") %></h1>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "contents" do |form| %>
    <%= render "errors", record: @user %>

    <%= render "fields", form:, hint: t(".api_key_hint"),
          status: @masked_api_key ? t(".api_key_stored", key: @masked_api_key) : t(".api_key_missing") %>

    <div class="mb-6">
      <%= form.submit t(".save"), class: "rounded-md px-4 py-2 bg-gray-900 text-white font-medium cursor-pointer" %>
    </div>
  <% end %>

  <% if @masked_api_key %>
    <%= button_to t(".delete_api_key"), settings_api_key_path, method: :delete,
          form: { data: { turbo_confirm: t(".confirm_delete_api_key") } },
          class: "text-red-700 underline cursor-pointer" %>
  <% end %>

  <div class="mt-10 border-t border-gray-200 pt-6">
    <p class="mb-3 text-gray-700"><%= t(".delete_account_hint") %></p>
    <%= button_to t(".delete_account"), settings_account_path, method: :delete,
          form: { data: { turbo_confirm: t(".confirm_delete_account") } },
          class: "rounded-md px-4 py-2 bg-red-700 text-white font-medium cursor-pointer" %>
  </div>
</div>
