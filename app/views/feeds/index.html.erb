<% content_for :title, t(".title") %>

<div class="w-full">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <%= link_to t(".new"), new_feed_path, class: "rounded-md px-4 py-2 bg-gray-900 text-white font-medium" %>
  </div>

  <% if @feeds.empty? %>
    <p class="text-gray-500"><%= t(".empty") %></p>
  <% else %>
    <ul class="divide-y divide-gray-200">
      <% @feeds.each do |feed| %>
        <li class="py-4 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <p class="font-medium truncate"><%= feed.title %></p>
            <p class="text-sm text-gray-500 truncate"><%= feed.url %></p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <%= link_to t(".edit"), edit_feed_path(feed), class: "text-gray-700 underline" %>
            <%= button_to t(".delete"), feed_path(feed), method: :delete,
                  class: "text-red-700 underline",
                  form: { data: { turbo_confirm: t(".confirm_delete", title: feed.title) } } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
