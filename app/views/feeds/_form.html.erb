<%= form_with model: feed, class: "contents" do |form| %>
  <%= render "errors", record: feed %>

  <div class="mb-4">
    <%= form.label :title, class: "block font-medium mb-1" %>
    <%= form.text_field :title, class: "block w-full rounded-md border border-gray-300 px-3 py-2" %>
  </div>

  <div class="mb-6">
    <%= form.label :url, class: "block font-medium mb-1" %>
    <%= form.url_field :url, class: "block w-full rounded-md border border-gray-300 px-3 py-2" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit class: "rounded-md px-4 py-2 bg-gray-900 text-white font-medium cursor-pointer" %>
    <%= link_to t(".back"), feeds_path, class: "text-gray-700 underline" %>
  </div>
<% end %>
