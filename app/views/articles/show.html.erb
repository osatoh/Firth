<% content_for :title, @article.title %>

<article class="w-full min-w-0">
  <h1 class="text-2xl font-bold mb-2 break-words"><%= @article.title %></h1>
  <p class="text-sm text-gray-500 mb-6">
    <%= render "meta", article: @article %>
  </p>

  <div class="flex gap-4">
    <%= render "original_link", article: @article, label: t(".original"),
          class: "text-blue-600 hover:underline cursor-pointer" %>
    <%= link_to t(".back"), articles_path, class: "text-gray-600 hover:underline" %>
  </div>
</article>
