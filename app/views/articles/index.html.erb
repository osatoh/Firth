<% content_for :title, t(".title") %>

<div class="w-full">
  <h1 class="text-2xl font-bold mb-6"><%= t(".title") %></h1>

  <% if @articles.empty? %>
    <p class="text-gray-500"><%= t(".empty") %></p>
    <p class="mt-2 text-gray-700">
      <%= t(".empty_hint_html", add_feed: link_to(t(".add_feed"), new_feed_path, class: "text-blue-600 hover:underline"),
            import: link_to(t(".import"), new_feeds_import_path, class: "text-blue-600 hover:underline")) %>
    </p>
  <% else %>
    <ul class="divide-y divide-gray-200">
      <% @articles.each do |article| %>
        <li class="py-4 min-w-0">
          <%= link_to article.title, article,
                class: ["hover:underline", article.read? ? "font-normal text-gray-500" : "font-bold"] %>
          <%= render "original_link", article:, label: t(".original"),
                class: "text-sm text-blue-600 hover:underline cursor-pointer" %>
          <p class="text-sm text-gray-500">
            <%= render "meta", article: %>
          </p>
        </li>
      <% end %>
    </ul>
    <% if @next_cursor %>
      <%= link_to t(".older"), articles_path(before: @next_cursor),
            class: "mt-6 inline-block text-blue-600 hover:underline" %>
    <% end %>
  <% end %>
</div>
